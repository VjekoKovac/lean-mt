module

public import MT.Configuration
public import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex
public import Mathlib.NumberTheory.NumberField.Discriminant.Different
public import Mathlib.RingTheory.FractionalIdeal.Norm
public import Mathlib.Tactic

/-!
# Norm separation and strip occupancy

These lemmas implement the number-field norm inequality in Appendix A and the
geometric lifting argument at the end of the arithmetic amplification section.
The inputs of the strip theorem are precisely the vertical and determinant gaps
obtained after normalizing the configuration. Nothing asserts that the tower or
the configurations exist.

The norm comparison uses mathlib's product formula at infinity and the
integral-norm calculation from the proof of
`NumberField.InfinitePlace.one_le_of_lt_one`. See `docs/arithmetic.md`.
-/

@[expose] public section

namespace MT.Arithmetic

open NumberField
open scoped BigOperators NumberField
open NumberField.InfinitePlace

/-- The absolute rational norm of a nonzero algebraic integer is at least one.
The cast and norm calculation follows mathlib's `InfinitePlace.one_le_of_lt_one`. -/
theorem one_le_abs_rational_norm {K : Type*} [Field K] [NumberField K]
    {x : 𝓞 K} (hx : x ≠ 0) : (1 : ℝ) ≤ |Algebra.norm ℚ (x : K)| := by
  rw [← Algebra.coe_norm_int, ← Int.cast_one, ← Int.cast_abs, Rat.cast_intCast, Int.cast_le]
  exact Int.one_le_abs (Algebra.norm_ne_zero_iff.mpr hx)

/-- A single real embedding cannot be too small when all other conjugates are bounded.
The exponent is exactly the number of other embeddings. -/
theorem conjugate_gap {K : Type*} [Field K] [NumberField K] [IsTotallyReal K]
    {x : 𝓞 K} (hx : x ≠ 0) {T : ℝ} (hT : 0 < T) (v : InfinitePlace K)
    (hb : ∀ w : InfinitePlace K, w ≠ v → w (x : K) ≤ T) :
    1 / T ^ (Module.finrank ℚ K - 1) ≤ v (x : K) := by
  classical
  have hprod : (1 : ℝ) ≤ ∏ w : InfinitePlace K, w (x : K) := by
    simpa only [← NumberField.InfinitePlace.prod_eq_abs_norm, IsTotallyReal.mult_eq, pow_one]
      using one_le_abs_rational_norm hx
  have hdim : Fintype.card (InfinitePlace K) = Module.finrank ℚ K := by
    rw [card_eq_nrRealPlaces_add_nrComplexPlaces, ← card_add_two_mul_card_eq_rank,
      nrComplexPlaces_eq_zero_iff.mpr (inferInstance : IsTotallyReal K)]
  have herase : (Finset.univ.erase v).card = Module.finrank ℚ K - 1 := by simp [hdim]
  have hother : (∏ w ∈ Finset.univ.erase v, w (x : K)) ≤ T ^ (Module.finrank ℚ K - 1) := by
    calc
      _ ≤ ∏ _w ∈ Finset.univ.erase v, T :=
        Finset.prod_le_prod₀ (fun w _ => apply_nonneg w _) (fun w hw => hb w (Finset.mem_erase.mp hw).1)
      _ = _ := by simp [herase]
  apply (div_le_iff₀ (pow_pos hT _)).2
  calc
    1 ≤ ∏ w : InfinitePlace K, w (x : K) := hprod
    _ = v (x : K) * ∏ w ∈ Finset.univ.erase v, w (x : K) :=
      (Finset.mul_prod_erase _ _ (Finset.mem_univ v)).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hother (apply_nonneg _ _)

open scoped nonZeroDivisors

/-- Algebraic form of the dual lattice separation in the rectangle-count proof.
The product of the principal ideal generated by a nonzero element of the
codifferent with the different is a nonzero integral ideal. -/
theorem dual_norm_discriminant {K : Type*} [Field K] [NumberField K] {x : K}
    (hx : x ≠ 0)
    (hdual : x ∈ FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (𝓞 K)⁰ K)) :
    (1 : ℚ) ≤ |Algebra.norm ℚ x| * (NumberField.discr K).natAbs := by
  let codiff := FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (𝓞 K)⁰ K)
  let diff : FractionalIdeal (𝓞 K)⁰ K := differentIdeal ℤ (𝓞 K)
  let p := FractionalIdeal.spanSingleton (𝓞 K)⁰ x
  have hcodiff : codiff ≠ 0 := FractionalIdeal.dual_ne_zero ℤ ℚ one_ne_zero
  have hinv : diff = codiff⁻¹ := coeIdeal_differentIdeal ℤ ℚ K (𝓞 K)
  have hsub : p * diff ≤ 1 := calc
    _ ≤ codiff * diff := by
      apply mul_le_mul_left
      exact FractionalIdeal.spanSingleton_le_iff_mem.mpr hdual
    _ = 1 := by rw [hinv, mul_inv_cancel₀ hcodiff]
  obtain ⟨J, hJ⟩ := FractionalIdeal.le_one_iff_exists_coeIdeal.mp hsub
  have hnorm : (J.absNorm : ℚ) = |Algebra.norm ℚ x| * (NumberField.discr K).natAbs := calc
    _ = FractionalIdeal.absNorm (J : FractionalIdeal (𝓞 K)⁰ K) :=
      (FractionalIdeal.coeIdeal_absNorm _).symm
    _ = _ := by
      rw [hJ, map_mul]
      simp [p, diff, FractionalIdeal.coeIdeal_absNorm, NumberField.absNorm_differentIdeal K]
  have hn₁ : 0 < |Algebra.norm ℚ x| := abs_pos.mpr (Algebra.norm_ne_zero_iff.mpr hx)
  have hn₂ : 0 < (NumberField.discr K).natAbs := Int.natAbs_pos.mpr (NumberField.discr_ne_zero K)
  have hJpos : (0 : ℚ) < J.absNorm := by
    rw [hnorm]
    exact mul_pos hn₁ (by exact_mod_cast hn₂)
  have hJone : 1 ≤ J.absNorm := by exact_mod_cast hJpos
  rw [← hnorm]
  exact_mod_cast hJone

/-- A nonzero algebraic vector in the trace-dual lattice has product of
absolute coordinates at least the reciprocal of the absolute discriminant. -/
theorem dual_product_gap {K : Type*} [Field K] [NumberField K] [IsTotallyReal K] {x : K}
    (hx : x ≠ 0)
    (htrace : ∀ a : 𝓞 K, ∃ z : ℤ, (z : ℚ) = Algebra.trace ℚ K (x * (a : K))) :
    1 / ((NumberField.discr K).natAbs : ℝ) ≤ ∏ w : InfinitePlace K, w x := by
  have hdual : x ∈ FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (𝓞 K)⁰ K) := by
    apply (FractionalIdeal.mem_dual one_ne_zero).2
    intro y hy
    obtain ⟨a, rfl⟩ := (FractionalIdeal.mem_one_iff _).mp hy
    exact htrace a
  have hreal : (1 : ℝ) ≤ |(Algebra.norm ℚ x : ℝ)| * ((NumberField.discr K).natAbs : ℝ) := by
    exact_mod_cast dual_norm_discriminant hx hdual
  have hprod : (∏ w : InfinitePlace K, w x) = |(Algebra.norm ℚ x : ℝ)| := by
    simpa only [IsTotallyReal.mult_eq, pow_one, Rat.cast_abs] using prod_eq_abs_norm x
  rw [hprod, div_le_iff₀]
  · exact hreal
  · exact_mod_cast Int.natAbs_pos.mpr (NumberField.discr_ne_zero K)

/-- A single positive constant controls all three normalizations in the gap lemma.
Here d=1 is a horizontal difference, d=2 is a vertical difference and d=3 is a determinant. -/
theorem normalized_integral_gap {K : Type*} [Field K] [NumberField K] [IsTotallyReal K]
    {x : 𝓞 K} (hx : x ≠ 0) {S T : ℝ} (hS : 1 ≤ S) (hT : 1 ≤ T)
    (v : InfinitePlace K) (hb : ∀ w : InfinitePlace K, w ≠ v → w (x : K) ≤ T)
    {d : ℕ} (hd : d ≤ 3) :
    100 / (100 * S ^ 3 * T) ^ Module.finrank ℚ K ≤
      |embedding_of_isReal (IsTotallyReal.isReal v) (x : K) / S ^ d| := by
  let k := Module.finrank ℚ K
  have hk : 1 ≤ k := Module.finrank_pos
  have hSp : 0 < S := by linarith
  have hTp : 0 < T := by linarith
  have hbase : 1 ≤ 100 * S ^ 3 := by
    have h : 1 ≤ S ^ 3 := one_le_pow₀ hS
    linarith
  have hden : 100 * S ^ d * T ^ (k - 1) ≤ (100 * S ^ 3 * T) ^ k := by
    rw [mul_pow]
    apply mul_le_mul
    · calc
        100 * S ^ d ≤ 100 * S ^ 3 :=
          mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hS hd) (by norm_num)
        _ = (100 * S ^ 3) ^ 1 := (pow_one _).symm
        _ ≤ (100 * S ^ 3) ^ k := pow_le_pow_right₀ hbase hk
    · exact pow_le_pow_right₀ hT (Nat.sub_le _ _)
    · positivity
    · positivity
  have hnorm := conjugate_gap hx hTp v hb
  rw [abs_div, abs_of_pos (pow_pos hSp _), ← Real.norm_eq_abs,
    norm_embedding_of_isReal]
  calc
    _ ≤ (1 / T ^ (k - 1)) / S ^ d := by
      rw [div_div, div_le_div_iff₀ (by positivity) (by positivity), one_mul]
      simpa only [mul_comm (T ^ _) (S ^ _), ← mul_assoc] using hden
    _ ≤ _ := div_le_div_of_nonneg_right hnorm (pow_nonneg hSp.le _)

/-- The oriented doubled area of three affine points. -/
def det₂ {K : Type*} [CommRing K] (p q r : K × K) : K :=
  (q.1 - p.1) * (r.2 - p.2) - (r.1 - p.1) * (q.2 - p.2)

/-- Project through one real embedding and apply the paper's parabolic scaling. -/
noncomputable def project {K : Type*} [Field K] (σ : K →+* ℝ) (S : ℝ) (p : K × K) :
    ℝ × ℝ := (σ p.1 / S, σ p.2 / S ^ 2)

theorem projected_det {K : Type*} [Field K] (σ : K →+* ℝ) {S : ℝ} (hS : S ≠ 0)
    (p q r : K × K) :
    det₂ (project σ S p) (project σ S q) (project σ S r) = σ (det₂ p q r) / S ^ 3 := by
  simp [det₂, project]
  field_simp

/-- A closed strip of slope m, lower intercept c and vertical width δ. -/
def InStrip (m c δ : ℝ) (p : ℝ × ℝ) : Prop :=
  c ≤ p.2 - m * p.1 ∧ p.2 - m * p.1 ≤ c + δ

private theorem sub_abs_le_of_interval {t a b δ : ℝ}
    (ha : t ≤ a ∧ a ≤ t + δ) (hb : t ≤ b ∧ b ≤ t + δ) : |a - b| ≤ δ := by
  apply abs_le.mpr
  constructor <;> linarith [ha.1, ha.2, hb.1, hb.2]

/-- Three points above [-1,1] in the same strip have doubled area at most 4δ. -/
theorem det_le_of_inStrip {m c δ : ℝ} {p q r : ℝ × ℝ}
    (hp : InStrip m c δ p) (hq : InStrip m c δ q) (hr : InStrip m c δ r)
    (hpx : |p.1| ≤ 1) (hqx : |q.1| ≤ 1) (hrx : |r.1| ≤ 1) : |det₂ p q r| ≤ 4 * δ := by
  have hx {x y : ℝ} (hx : |x| ≤ 1) (hy : |y| ≤ 1) : |x - y| ≤ 2 := by
    rcases abs_le.mp hx with ⟨hx₁, hx₂⟩
    rcases abs_le.mp hy with ⟨hy₁, hy₂⟩
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have heq : det₂ p q r =
      (q.1 - p.1) * ((r.2 - m * r.1) - (p.2 - m * p.1)) -
      (r.1 - p.1) * ((q.2 - m * q.1) - (p.2 - m * p.1)) := by unfold det₂; ring
  rw [heq]
  calc
    _ ≤ |(q.1 - p.1) * ((r.2 - m * r.1) - (p.2 - m * p.1))| +
        |(r.1 - p.1) * ((q.2 - m * q.1) - (p.2 - m * p.1))| := abs_sub _ _
    _ ≤ 2 * δ + 2 * δ := by
      simp only [abs_mul]
      exact add_le_add
        (mul_le_mul (hx hqx hpx) (sub_abs_le_of_interval hr hp) (abs_nonneg _) (by norm_num))
        (mul_le_mul (hx hrx hpx) (sub_abs_le_of_interval hq hp) (abs_nonneg _) (by norm_num))
    _ = _ := by ring

/-- Above a fixed horizontal coordinate the strip captures at most one
vertical coordinate when distinct ordinates are separated by 100δ. -/
theorem vertical_eq_of_inStrip {m c δ : ℝ} (hδ : 0 < δ) {p q : ℝ × ℝ}
    (hp : InStrip m c δ p) (hq : InStrip m c δ q) (hx : p.1 = q.1)
    (hgap : p.2 ≠ q.2 → 100 * δ ≤ |p.2 - q.2|) : p.2 = q.2 := by
  by_contra h
  have hd := sub_abs_le_of_interval hp hq
  rw [hx, sub_sub_sub_cancel_right] at hd
  linarith [hgap h]

/-- Given the two gaps of the preceding lemma in the paper, all points
of an embedded, scaled configuration in a single strip lift to one
nonvertical affine line over K. Covers empty and singleton configurations. -/
theorem strip_lifts_to_field_line {K : Type*} [Field K] (σ : K →+* ℝ) {S δ m c : ℝ}
    (hS : S ≠ 0) (hδ : 0 < δ) (B : Set (K × K))
    (hbox : ∀ p ∈ B, |(project σ S p).1| ≤ 1)
    (hstrip : ∀ p ∈ B, InStrip m c δ (project σ S p))
    (hvert : ∀ p ∈ B, ∀ q ∈ B, (project σ S p).2 ≠ (project σ S q).2 →
      100 * δ ≤ |(project σ S p).2 - (project σ S q).2|)
    (hdet : ∀ p ∈ B, ∀ q ∈ B, ∀ r ∈ B,
      det₂ (project σ S p) (project σ S q) (project σ S r) ≠ 0 →
      100 * δ ≤ |det₂ (project σ S p) (project σ S q) (project σ S r)|) :
    ∃ u v : K, ∀ p ∈ B, p.2 = u * p.1 + v := by
  classical
  by_cases hpair : ∃ p ∈ B, ∃ q ∈ B, q.1 ≠ p.1
  · obtain ⟨p, hp, q, hq, hneq⟩ := hpair
    let u := (q.2 - p.2) / (q.1 - p.1)
    refine ⟨u, p.2 - u * p.1, ?_⟩
    intro r hr
    have hzero : det₂ (project σ S p) (project σ S q) (project σ S r) = 0 := by
      by_contra hn
      linarith [det_le_of_inStrip (hstrip p hp) (hstrip q hq) (hstrip r hr)
        (hbox p hp) (hbox q hq) (hbox r hr), hdet p hp q hq r hr hn]
    rw [projected_det σ hS] at hzero
    have hK : det₂ p q r = 0 := by
      apply σ.injective
      simpa [hS] using hzero
    dsimp [u]
    field_simp [sub_ne_zero.mpr hneq]
    unfold det₂ at hK
    linear_combination hK
  · by_cases hB : B.Nonempty
    · obtain ⟨p, hp⟩ := hB
      refine ⟨0, p.2, ?_⟩
      intro q hq
      have hx : q.1 = p.1 := by
        by_contra h
        exact hpair ⟨p, hp, q, hq, h⟩
      have hy := vertical_eq_of_inStrip hδ (hstrip q hq) (hstrip p hp)
        (by simp [project, hx]) (hvert q hq p hp)
      have hyK : q.2 = p.2 := by
        apply σ.injective
        simpa [project, hS] using hy
      simpa using hyK
    · exact ⟨0, 0, fun p hp => (hB ⟨p, hp⟩).elim⟩

/-- Finite strip occupancy of the projected configuration is bounded by its
uniform nonvertical field-line occupancy. All gap assumptions refer to B, before
choosing the intercept or slope. This is the finite cardinal inequality in the paper. -/
theorem projected_strip_card_le {K : Type*} [Field K] [DecidableEq K]
    (σ : K →+* ℝ) (S : ℝ) (hS : S ≠ 0) (B : Finset (K × K))
    {δ : ℝ} (hδ : 0 < δ) (L : ℕ)
    (hbox : ∀ p ∈ B, |(project σ S p).1| ≤ 1)
    (hvert : ∀ p ∈ B, ∀ q ∈ B, (project σ S p).2 ≠ (project σ S q).2 →
      100 * δ ≤ |(project σ S p).2 - (project σ S q).2|)
    (hdet : ∀ p ∈ B, ∀ q ∈ B, ∀ r ∈ B,
      det₂ (project σ S p) (project σ S q) (project σ S r) ≠ 0 →
      100 * δ ≤ |det₂ (project σ S p) (project σ S q) (project σ S r)|)
    (hline : ∀ u v : K, (B.filter (fun p => p.2 = u * p.1 + v)).card ≤ L)
    (s c : ℝ) :
    (((B.map (projectedPoint σ S hS)).filter
      (fun p => p.2 - 2 * s * p.1 ∈ Set.Icc c (c + δ))).card) ≤ L := by
  classical
  let points := {p : K × K | p ∈ B ∧ InStrip (2 * s) c δ (project σ S p)}
  obtain ⟨u, v, h⟩ := strip_lifts_to_field_line σ hS hδ points
    (fun p hp => hbox p hp.1) (fun _ hp => hp.2)
    (fun p hp q hq => hvert p hp.1 q hq.1)
    (fun p hp q hq r hr => hdet p hp.1 q hq.1 r hr.1)
  rw [Finset.filter_map, Finset.card_map]
  apply (Finset.card_le_card _).trans (hline u v)
  intro p hp
  obtain ⟨hpB, hpI⟩ := Finset.mem_filter.mp hp
  exact Finset.mem_filter.mpr ⟨hpB, h p ⟨hpB, hpI⟩⟩

end MT.Arithmetic
